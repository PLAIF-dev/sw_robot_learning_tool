# ==============================
# Robot Learning Tool - 환경 변수
# ==============================
# 이 파일을 복사하여 .env 로 저장하고 값을 수정하세요.
# cp .env.example .env

# 인증
AUTH_PASSWORD=1111

# 포트
BACKEND_PORT=8080
FRONTEND_PORT=5173

# ASP.NET Core 환경
ASPNETCORE_ENVIRONMENT=Development

# CORS - 프론트엔드 주소
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 프론트엔드 -> 백엔드 API 주소 (docker compose 내부에서는 service name 사용)
VITE_API_BASE_URL=http://localhost:8080
